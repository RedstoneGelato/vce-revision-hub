rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in student can read and write only their own progress document.
    // Tutors (listed by account ID below) can read everyone's progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid in ["PASTE_TUTOR_ACCOUNT_ID_HERE"];
    }
  }
}
